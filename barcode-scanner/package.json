{
  "name": "barcode-scanner-background",
  "version": "1.0.0",
  "description": "Application en arrière-plan pour scanner les QR codes de renouvellement",
  "main": "scanner-wrapper.js",
  "bin": "scanner-wrapper.js",
  "scripts": {
    "start": "node scanner.js",
    "build": "node build.js",
    "create-installer": "node create-installer.js",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "electron": "^28.0.0",
    "clipboardy": "^3.0.0"
  },
  "devDependencies": {
    "node-windows": "^1.0.0-beta.8",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "config.json",
      "node_modules/clipboardy/fallbacks/windows/clipboard_x86_64.exe"
